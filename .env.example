# ==============================================================================
# NetraDrishti — Environment Variables Template
# Copy to .env for local overrides; never commit real .env files or secrets.
# ==============================================================================

# --- Backend Environment & Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=true
NETRADRISHTI_DEVICE=cpu
TORCH_NUM_THREADS=1
OMP_NUM_THREADS=1
MODEL_DIR=./models

# --- Upload, Security & Concurrency Guardrails ---
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_CONCURRENT_INFERENCE=4
INFERENCE_TIMEOUT_SECONDS=60.0

# Comma-separated CORS origins (do NOT use '*' in production; set Azure Static Web Apps URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Frontend Configuration (Vite Build-Time) ---
# Set to your Azure Container Apps HTTPS URL when building for Azure Static Web Apps
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_DOCS=true
