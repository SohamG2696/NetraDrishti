# ==============================================================================
# NetraDrishti — Environment Variables Template
# Copy this file to .env (or configure your deployment environment accordingly)
# ==============================================================================

# --- Backend Configuration ---
# Maximum upload payload size in bytes (Default: 10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# Comma-separated list of allowed CORS origins for React frontend integration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Frontend Configuration ---
# Base URL for the FastAPI backend service
# Leave empty when using Vite's internal development proxy (/api)
VITE_API_BASE_URL=http://localhost:8000
