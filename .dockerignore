# Exclude large datasets, local checkpoints, frontend, notebooks, and secrets
.git/
.github/
.gitignore
.env
.env.*
!.env.example
.vscode/
.idea/
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
__pycache__/
*.py[cod]
.pytest_cache/
anaconda_projects/

# Local datasets & archives
OCT/
RFMiD/
Fundus/
OCT.zip
*.zip
*.tar
*.tar.gz

# Frontend, notebooks, docs & host-only scripts (not needed in backend API container)
frontend/
notebooks/
tests/
deploy/
scripts/*
!scripts/entrypoint.sh

# Exclude everything in models/ except the 4 bundled runtime artifacts
models/*
!models/swin_tiny_epoch3.pth
!models/netradrishti_fundus_ensemble.pth
!models/modality_validator_stats.npz
!models/efficientnet_b0_rwightman-7f5810bc.pth

*.log
Thumbs.db
.DS_Store

