# ==============================================================================
# NetraDrishti Frontend — Vite Environment Variables Template
# ==============================================================================
# Production Azure Container Apps backend URL (HTTPS, no trailing slash)
# Example: VITE_API_BASE_URL=https://netradrishti-api.<region>.azurecontainerapps.io
# Leave empty during local Vite development to use vite.config.ts proxy (/api)
VITE_API_BASE_URL=

# Set to "false" to hide Swagger documentation links in production UI
VITE_ENABLE_DOCS=true

